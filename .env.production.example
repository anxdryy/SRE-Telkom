APP_NAME="SRE Telkom University"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Hostinger hPanel > Databases > MySQL Databases gives you these four values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_srewebsite
DB_USERNAME=u123456789_sreadmin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Set these to your own admin login before running:
#   php artisan db:seed --class=AdminUserSeeder
ADMIN_NAME="SRE Admin"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
